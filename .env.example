# Salin menjadi .env lalu isi nilainya: cp .env.example .env
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta

# Database (dipakai docker-compose.yml dan koneksi.php)
DB_NAME=pedulikasih
DB_USER=peduli
DB_PASSWORD=ganti_dengan_password_kamu
DB_PORT_HOST=5433

# pgAdmin (GUI database) di http://localhost:5050
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@pedulikasih.com
PGADMIN_PASSWORD=ganti_dengan_password_kamu

# Hanya dipakai docker-compose.existing-db.yml (PostgreSQL yang sudah ada)
# DB_HOST=postgres_db
# DB_NETWORK=postgresql_default
