# Konfigurasi stack PeduliKasih untuk Dockge.
# Salin file ini menjadi .env di folder stack (/opt/stacks/pedulikasih/.env),
# lalu sesuaikan nilainya. Dockge bisa mengedit file ini lewat tab "Env".

# Lokasi sumber kode di host (folder repo hasil git clone)
APP_SOURCE=/home/faiq/Project_PemwebPraktikum

# Aplikasi
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080
APP_TIMEZONE=Asia/Jakarta

# Database
DB_NAME=pedulikasih
DB_USER=peduli
DB_PASSWORD=ubah_password_ini
DB_PORT_HOST=5433

# pgAdmin (GUI untuk melihat isi database)
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@pedulikasih.com
PGADMIN_PASSWORD=ganti_password_ini
